---
// PROTOTIPO descartable. Dirección C, "Pared": el fondo es el gris de la pared de las fotos, así la foto del hero sale
// de la página sin borde. Conserva la tipografía de la marca (Playfair e Inter, ya autoalojadas). El catálogo es una
// grilla de dos columnas por hilera: una hilera impar abre con una pieza a todo el ancho. El detalle va en una hoja.
import { hrefInstagram, hrefWhatsappGeneral, hrefWhatsappProducto, INSTAGRAM } from '../../catalogo/contacto'
import IconoInstagram from '../../catalogo/IconoInstagram.astro'
import IconoWhatsapp from '../../catalogo/IconoWhatsapp.astro'
import { disenos, formatearPrecio, textoMedida } from '../../catalogo/presentacion'
import Base from './_Base.astro'
import { grupos, productos } from './_datos'
---

<Base titulo="Prototipo C: Pared" actual="C">
  <div class="c">
    <header class="barra">
      <a class="marca" href="/prototipos/home-c">
        <img src="/assets/logo-160.webp" width="160" height="160" alt="" />
        <span>El Cauquén Artesanías</span>
      </a>
      <a class="barra__ig" href={hrefInstagram} target="_blank" rel="noopener noreferrer" aria-label={`Instagram ${INSTAGRAM}`}>
        <IconoInstagram tamano={20} />
      </a>
    </header>

    <section class="hero">
      <h1>Piezas únicas en madera, hechas a mano</h1>
      <p>Torneadas una por una. Consultá precio y disponibilidad por WhatsApp.</p>
      <a class="boton" href={hrefWhatsappGeneral} target="_blank" rel="noopener noreferrer">
        <IconoWhatsapp tamano={18} /> Escribir por WhatsApp
      </a>
      <img
        class="hero__foto"
        src="/assets/porta-sahumerio-640.webp"
        srcset="/assets/porta-sahumerio-640.webp 640w, /assets/porta-sahumerio.webp 1600w"
        sizes="100vw"
        width="640"
        height="953"
        alt="Dos porta sahumerios torneados con sahumerios encendidos"
        fetchpriority="high"
      />
    </section>

    <main class="piezas" aria-label="Piezas">
      {
        grupos.map((grupo) => (
          <ul class:list={['hilera', { 'hilera--impar': grupo.length % 2 === 1 }]}>
            {grupo.map(({ producto, indice }) => (
              <li>
                <button type="button" class="pieza" data-abre={`hoja-${indice}`}>
                  {producto.galeria[0] && (
                    <img src={producto.galeria[0].url640} width="640" height="640" alt="" loading="lazy" decoding="async" />
                  )}
                  <span class="pieza__nombre">{producto.nombre}</span>
                  <span class="pieza__precio">{formatearPrecio(producto.precio)}</span>
                </button>
              </li>
            ))}
          </ul>
        ))
      }
    </main>

    <footer class="pie">
      <div class="pie__fila">
        <a class="boton boton--claro" href={hrefWhatsappGeneral} target="_blank" rel="noopener noreferrer">
          <IconoWhatsapp tamano={18} /> WhatsApp
        </a>
        <a class="boton boton--borde" href={hrefInstagram} target="_blank" rel="noopener noreferrer">
          <IconoInstagram tamano={18} /> Instagram
        </a>
      </div>
      <p>Pagás en efectivo, por transferencia o con Mercado Pago. Precios por unidad.</p>
      <p class="pie__credito">
        © El Cauquén Artesanías. Diseñado por <a href="https://kevindefalco.dev" target="_blank" rel="noopener noreferrer">Kevo</a>
      </p>
    </footer>

    {
      productos.map((producto, indice) => {
        const listaDisenos = disenos(producto.galeria)
        return (
          <dialog class="hoja" id={`hoja-${indice}`} aria-labelledby={`hoja-${indice}-titulo`}>
            <form method="dialog" class="hoja__cerrar">
              <button aria-label="Cerrar">
                <svg width="14" height="14" viewBox="0 0 14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" /></svg>
              </button>
            </form>
            <div class="hoja__fotos">
              {producto.galeria.map((imagen, i) => (
                <figure>
                  <img src={imagen.url640} width="640" height="640" alt={imagen.nombreDiseno ?? (i === 0 ? `Ficha de ${producto.nombre}` : producto.nombre)} loading="lazy" decoding="async" />
                  {imagen.nombreDiseno && <figcaption>{imagen.nombreDiseno}</figcaption>}
                </figure>
              ))}
            </div>
            <div class="hoja__cuerpo">
              <div class="hoja__cabeza">
                <h2 id={`hoja-${indice}-titulo`}>{producto.nombre}</h2>
                <span>{formatearPrecio(producto.precio)}</span>
              </div>
              {producto.descripcion && <p>{producto.descripcion}</p>}
              {producto.medidas.length > 0 && (
                <p class="hoja__tenue">{producto.medidas.map(textoMedida).join(', ')}</p>
              )}
              {listaDisenos.length > 0 && (
                <p class="hoja__tenue">
                  Diseños: {listaDisenos.map((d) => d.etiqueta.toLowerCase()).join(', ')}. Deslizá las fotos para verlos.
                </p>
              )}
              <a class="boton" href={hrefWhatsappProducto(producto.nombre)} target="_blank" rel="noopener noreferrer">
                <IconoWhatsapp tamano={18} /> Consultar por WhatsApp
              </a>
            </div>
          </dialog>
        )
      })
    }
  </div>
</Base>

<script>
  for (const boton of document.querySelectorAll<HTMLElement>('[data-abre]')) {
    boton.addEventListener('click', () => {
      const hoja = document.getElementById(boton.dataset.abre ?? '') as HTMLDialogElement | null
      hoja?.showModal()
    })
  }
  for (const hoja of document.querySelectorAll('dialog')) {
    hoja.addEventListener('click', (e) => {
      if (e.target === hoja) hoja.close()
    })
  }
</script>

<style>
  @font-face {
    font-family: 'Playfair Display';
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url('/assets/fonts/playfair-latin-var.woff2') format('woff2');
  }

  @font-face {
    font-family: Inter;
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url('/assets/fonts/inter-latin-var.woff2') format('woff2');
  }

  .c {
    /* El gris de la pared de las fotos sin placa (porta sahumerios, velas, mates). */
    --pared: #e4e3e0;
    --mesa: #d2d1cd;
    --tinta: #231a13;
    --tenue: #5e554c;
    --calden: #7a3a1e;
    min-height: 100svh;
    background: var(--pared);
    color: var(--tinta);
    font: 400 15px/1.55 Inter, sans-serif;
  }

  :global(body) {
    margin: 0;
    background: #e4e3e0;
  }

  .c :where(a, button):focus-visible {
    outline: 2px solid var(--calden);
    outline-offset: 3px;
  }

  h1,
  h2 {
    margin: 0;
    font-family: 'Playfair Display', serif;
    font-weight: 500;
    text-wrap: balance;
  }

  /* ---------- Barra ---------- */

  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 0 10px 0 16px;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    font: 500 17px/1 'Playfair Display', serif;
  }

  .marca img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
  }

  .barra__ig {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--tinta);
  }

  /* ---------- Hero ---------- */

  .hero {
    padding: 12px 20px 0;
  }

  .hero h1 {
    font-size: clamp(27px, 7.6vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .hero p {
    margin: 10px 0 18px;
    color: var(--tenue);
  }

  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--tinta);
    color: var(--pared);
    font-weight: 500;
    text-decoration: none;
  }

  .boton--claro {
    background: var(--pared);
    color: var(--tinta);
  }

  .boton--borde {
    background: none;
    color: var(--pared);
    box-shadow: inset 0 0 0 1px rgba(228, 227, 224, 0.4);
  }

  /* La foto sale de la pared: el borde de arriba se funde con el fondo. */
  .hero__foto {
    display: block;
    width: calc(100% + 40px);
    height: 52svh;
    min-height: 280px;
    margin: 4px -20px 0;
    object-fit: cover;
    object-position: 50% 78%;
    mask-image: linear-gradient(to bottom, transparent 0, #000 22%);
  }

  /* ---------- Piezas ---------- */

  .piezas {
    padding: 28px 16px 40px;
  }

  .hilera {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 12px;
    margin: 0 0 36px;
    padding: 0;
    list-style: none;
  }

  .hilera--impar li:first-child {
    grid-column: 1 / -1;
  }

  .pieza {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .pieza img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 3px;
    background: var(--mesa);
  }

  .pieza__nombre {
    display: block;
    margin-top: 8px;
    font: 500 16px/1.2 'Playfair Display', serif;
  }

  .hilera--impar li:first-child .pieza__nombre {
    font-size: 20px;
  }

  .pieza__precio {
    display: block;
    margin-top: 2px;
    color: var(--calden);
    font-size: 14px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Pie ---------- */

  .pie {
    padding: 32px 20px calc(80px + env(safe-area-inset-bottom));
    background: var(--tinta);
    color: rgba(228, 227, 224, 0.75);
  }

  .pie__fila {
    display: flex;
    gap: 10px;
  }

  .pie__fila .boton {
    flex: 1;
  }

  .pie p {
    margin: 18px 0 0;
  }

  .pie__credito {
    font-size: 12px;
  }

  .pie__credito a {
    color: var(--pared);
  }

  /* ---------- Hoja ---------- */

  .hoja {
    width: 100%;
    max-width: 100%;
    max-height: 94svh;
    margin: auto 0 0;
    padding: 0 0 env(safe-area-inset-bottom);
    border: 0;
    border-radius: 14px 14px 0 0;
    background: var(--pared);
    color: var(--tinta);
    overflow-y: auto;
    transition:
      transform 260ms cubic-bezier(0.22, 0.61, 0.36, 1),
      overlay 260ms allow-discrete,
      display 260ms allow-discrete;
    transform: translateY(100%);
  }

  .hoja[open] {
    transform: translateY(0);
  }

  @starting-style {
    .hoja[open] {
      transform: translateY(100%);
    }
  }

  .hoja::backdrop {
    background: rgba(35, 26, 19, 0.6);
  }

  .hoja__cerrar {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 0;
    display: flex;
    justify-content: flex-end;
  }

  .hoja__cerrar button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin: 10px 10px 0 0;
    border: 0;
    border-radius: 50%;
    background: var(--pared);
    color: var(--tinta);
    cursor: pointer;
  }

  .hoja__fotos {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .hoja__fotos figure {
    position: relative;
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
  }

  .hoja__fotos img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }

  .hoja__fotos figcaption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--pared);
    font-size: 13px;
  }

  .hoja__cuerpo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px 20px 24px;
  }

  .hoja__cuerpo p {
    margin: 0;
  }

  .hoja__cabeza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .hoja h2 {
    font-size: 24px;
    line-height: 1.15;
  }

  .hoja__cabeza span {
    color: var(--calden);
    font-size: 17px;
    font-weight: 600;
    white-space: nowrap;
  }

  .hoja__tenue {
    color: var(--tenue);
  }

  @media (prefers-reduced-motion: reduce) {
    .hoja,
    .hoja[open] {
      transition: none;
      transform: none;
    }
  }
</style>
