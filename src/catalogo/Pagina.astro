---
// Layout del sitio público (F11-D3): el catálogo y las páginas de error comparten `<head>` y estilos.
import './catalogo.css'

interface Props {
  titulo: string
  descripcion?: string
}

const { titulo, descripcion } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <link rel="icon" href="/assets/logo-160.webp" />
    <link rel="preload" href="/assets/fonts/playfair-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/playfair-latin-italic-var.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Cloudflare Web Analytics: visitas y Core Web Vitals, sin cookies ni datos personales. El token es público. -->
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token": "bcc525bf0c4c49da9d7fef468bf9a7d3"}'
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
