---
// Layout del admin (F4-D5). Con `protegida`, muestra la barra con el integrante y "Cerrar sesión";
// la isla de la página espera la sesión con `exigirSesion()` antes de mostrar su contenido (F4-D3).
import './admin.css'

interface Props {
  titulo: string
  protegida?: boolean
}

const { titulo, protegida = true } = Astro.props

// Secciones de la barra (F5-D1, F6-D1, F12-D4). "Integrantes" lleva `soloOwner`: `admin.css` lo oculta hasta
// que la barra tenga `data-rol="owner"` (F9-D1). El ícono (trazos de 20×20, como `iconos.tsx`) solo se ve en la
// barra de abajo del teléfono.
const secciones = [
  {
    href: '/admin/productos',
    texto: 'Productos',
    icono: ['M3 6.5L10 3l7 3.5v7L10 17l-7-3.5z', 'M3 6.5l7 3.5 7-3.5M10 10v7'],
  },
  {
    href: '/admin/categorias',
    texto: 'Categorías',
    icono: ['M3 3h6.5l7.5 7.5-6.5 6.5L3 9.5z', 'M6.5 5.5a1 1 0 1 0 0 2a1 1 0 1 0 0-2z'],
  },
  {
    href: '/admin/tipos-de-medida',
    texto: 'Medidas',
    icono: ['M2.5 7h15v6h-15z', 'M5.5 7v2.5M8.5 7v3.5M11.5 7v2.5M14.5 7v3.5'],
  },
  {
    href: '/admin/integrantes',
    texto: 'Integrantes',
    soloOwner: true,
    icono: [
      'M7.5 4.5a2.5 2.5 0 1 0 0 5a2.5 2.5 0 1 0 0-5z',
      'M2.5 16c0-2.8 2.2-4.5 5-4.5s5 1.7 5 4.5',
      'M13.5 5.5a2 2 0 1 1 0 4',
      'M14.5 11.6c1.8.3 3 1.9 3 4.4',
    ],
  },
]
const actual = Astro.url.pathname.replace(/\/$/, '')
// Por prefijo: "Productos" queda marcado también en `/admin/productos/editar`.
const esActual = (href: string) => actual === href || actual.startsWith(`${href}/`)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!-- F12-D3: `viewport-fit=cover` para las safe areas; sin `interactive-widget`, que subiría la barra de abajo con el teclado. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#4a331e" />
    <meta name="robots" content="noindex" />
    <title>{titulo} · Panel de El Cauquén</title>
    <link rel="icon" href="/assets/logo-160.webp" />
  </head>
  <body>
    {
      protegida && (
        <header class="panel__bar" id="barra">
          <p class="panel__marca">
            <a href="/admin/productos">
              El Cauquén <span>· Panel</span>
            </a>
          </p>
          <nav class="panel__nav" aria-label="Secciones">
            {
              secciones.map(({ href, texto, soloOwner, icono }) => (
                <a
                  href={href}
                  aria-current={esActual(href) ? 'page' : undefined}
                  data-solo-owner={soloOwner ? '' : undefined}
                >
                  <svg
                    class="panel__icono"
                    width="22"
                    height="22"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    {icono.map((d) => (
                      <path d={d} />
                    ))}
                  </svg>
                  <span>{texto}</span>
                </a>
              ))
            }
          </nav>
          <div class="panel__acciones" id="barraSesion" hidden>
            <span class="panel__integrante" id="barraIntegrante" />
            <button type="button" class="btn btn--fantasma" id="btnCerrarSesion">
              Cerrar sesión
            </button>
          </div>
        </header>
      )
    }
    <main class="panel__contenido">
      <div class="panel__marco">
        <slot />
      </div>
    </main>
    <!-- Región de avisos (F5-D5): existe vacía desde el inicio para que los lectores la anuncien. -->
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>

<script>
  import { auth } from '../api'
  import { avisar } from './avisos'
  import { mensajeDeError } from './mensajes'
  import { obtenerSesion } from './sesion'

  const barra = document.getElementById('barra')
  if (barra) {
    // Sin sesión o con error, la barra queda sin integrante: el guard y los errores son de la isla.
    obtenerSesion()
      .then((integrante) => {
        if (!integrante) return
        // Con el rol en la barra, `admin.css` muestra "Integrantes" solo al owner (F4-D3, F9-D1).
        barra.dataset['rol'] = integrante.rol
        document.getElementById('barraIntegrante')!.textContent = integrante.nombre
        document.getElementById('barraSesion')!.hidden = false
      })
      .catch(() => {})
    const boton = document.getElementById('btnCerrarSesion') as HTMLButtonElement
    boton.addEventListener('click', async () => {
      boton.disabled = true
      try {
        await auth.cerrarSesion()
        location.assign('/admin/ingresar')
      } catch (error) {
        boton.disabled = false
        avisar(mensajeDeError(error), 'error')
      }
    })
  }
</script>
