{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.elcauquenartesanias.com.ar"
        }
      ],
      "destination": "/admin/productos",
      "permanent": false
    },
    {
      "source": "/:ruta((?!admin(?:/|$)|_astro/|assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "admin.elcauquenartesanias.com.ar"
        }
      ],
      "destination": "/admin/:ruta",
      "permanent": false
    },
    {
      "source": "/admin",
      "missing": [
        {
          "type": "host",
          "value": "admin.elcauquenartesanias.com.ar"
        }
      ],
      "destination": "https://admin.elcauquenartesanias.com.ar/admin/productos",
      "permanent": false
    },
    {
      "source": "/admin/:ruta*",
      "missing": [
        {
          "type": "host",
          "value": "admin.elcauquenartesanias.com.ar"
        }
      ],
      "destination": "https://admin.elcauquenartesanias.com.ar/admin/:ruta*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
